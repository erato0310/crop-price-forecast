# 키를 발급받는 대로 이 파일을 .env로 복사해서 채운다 (docs/api_registration_guide.md 참고)

# KAMIS OpenAPI (kamis.or.kr) — 도매/공판장 가격
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 공공데이터포털 (data.go.kr) — 기상청 ASOS, 흙토람 토양적성, 농축산물 소득정보, 관세청 수출입
DATA_GO_KR_KEY=

# KOSIS OpenAPI (kosis.kr) — 재배면적
KOSIS_KEY=

# 한국은행 ECOS OpenAPI (ecos.bok.or.kr) — 환율/소비자심리지수
BOK_ECOS_KEY=

# 농축산물 소득정보(3060748) odcloud uddi — data.go.kr 활용신청 승인 후 "미리보기/요청URL"에서 확인
# 소득 데이터는 연 1회 갱신이라 API 대신 정적 CSV로 대체해도 무방 (docs/RESOLVE_GUIDE.md 참고)
INCOME_UDDI=
MAFRA_KEY=
